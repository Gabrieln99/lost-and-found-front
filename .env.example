# Copy to .env.local and fill in.
VITE_CONTRACT_ADDRESS=

# URL of the lost-and-found-back storage service (aiohttp). Point at
# http://localhost:8080 for local dev; update to the deployed Render URL
# once the storage service is deployed there.
VITE_STORAGE_SERVICE_URL=

# Public IPFS gateway used to read listing metadata/images back. Empty
# falls back to https://gateway.pinata.cloud/ipfs/ (matches the storage
# service, which pins there).
VITE_IPFS_GATEWAY_URL=
